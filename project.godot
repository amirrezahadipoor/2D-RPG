; Engine configuration file.
; 2D-RPG — pixel-art, offline, bilingual (EN/FA). Godot 4.4.
;
; NOTE: GDScript warnings are intentionally left ENABLED.
; The previous revision of this project disabled 10 warning categories,
; which is what allowed 15 parse errors to ship unnoticed.

config_version=5

[application]

config/name="2D RPG"
config/description="Hardcore offline pixel-art 2D RPG. Bilingual EN/FA."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.06, 0.06, 0.09, 1)
boot_splash/show_image=false

[autoload]

I18N="*res://src/autoload/i18n.gd"
Game="*res://src/autoload/game.gd"
Stats="*res://src/autoload/stats.gd"
Juice="*res://src/autoload/juice.gd"
Inventory="*res://src/autoload/inventory.gd"
QuestLog="*res://src/autoload/questlog.gd"
Settings="*res://src/autoload/settings.gd"
Sfx="*res://src/autoload/sfx.gd"

[audio]

buses/default_bus_layout="res://assets/audio/bus_layout.tres"

[display]

; Native pixel-art resolution. Everything is authored at 480x270 and
; upscaled by an INTEGER factor, so pixels stay perfectly square.
; Authored space stays 480x270, but the game now RENDERS at up to 4x with
; stretch mode canvas_items: UI text is rasterized at the final resolution
; (crisp instead of blocky) while sprites keep nearest-neighbour pixel purity.
; aspect "keep" letterboxes the 480x270 stage to the centre of ANY phone
; screen (18.5:9, 20:9, tablets...), so every pixel-art panel stays exactly
; where it was authored instead of drifting off-centre on ultra-wide devices.
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation="sensor_landscape"

[gui]

theme/default_font_size=8

