; Engine configuration file.
config_version=5

[application]
name="2D RPG"
run/main_scene="res://scenes/main_scene.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.07, 0.07, 0.07, 1)

[autoload]
PolishManager="*res://src/polish/polish_manager.gd"
GameManager="*res://src/core/game_manager.gd"
SaveManager="*res://src/core/save_manager.gd"
AudioManager="*res://src/audio/audio_manager.gd"
UIManager="*res://src/ui/ui_manager.gd"
LocalizationManager="*res://src/localization/localization_manager.gd"
TouchControls="*res://src/input/touch_controls.gd"
PersianNumerals="*res://src/utils/persian_numerals.gd"

