# Godot 4 cache (NEVER commit). Note: *.import sidecar files ARE committed on
# purpose - without them a fresh clone cannot preload imported resources.
.godot/

# Builds / exports
build/
export/
*.apk
*.aab
*.exe
*.x86_64
*.pck

# Keystores / secrets
*.keystore
*.jks
*.p12
.env
**/.env

# Script UIDs and import sidecars for docs images are regenerated on first
# import with 0 warnings (verified in CI); only assets/ sidecars are committed.
*.uid
docs/screenshots/*.import

# Editor / OS cruft
*.tmp
.DS_Store
Thumbs.db

# CI build logs (written by the android-apk workflow / ci_replay)
/import.log
/export.log
/sign.log
/badging.txt
*.idsig
